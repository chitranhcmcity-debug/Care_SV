{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --ignore-path ../.prettierignore --write src public/sw.js *.json ../backend/{app,server}.js ../backend/{config,constants,controllers,middleware,models,routes,services,utils,tests,scripts}/**/*.js ../README.md ../.prettierrc.json",
    "format:check": "prettier --ignore-path ../.prettierignore --check src public/sw.js *.json ../backend/{app,server}.js ../backend/{config,constants,controllers,middleware,models,routes,services,utils,tests,scripts}/**/*.js ../README.md ../.prettierrc.json"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
