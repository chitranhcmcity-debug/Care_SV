PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/itc_care
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Leave empty for same-origin requests through the Angular proxy.
CORS_ORIGINS=
# Temporary database and sample data are opt-in and disabled in production.
USE_MEMORY_DB=false
SEED_DEMO=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Trợ lý AI (gợi ý cuộc gọi, đánh giá minh chứng, chat, đánh giá nhân viên).
# Lấy key tại https://console.anthropic.com. Để trống thì các API /api/ai/* trả lỗi 503 rõ ràng.
ANTHROPIC_API_KEY=
# Tùy chọn, mặc định claude-opus-5 nếu để trống.
AI_MODEL=
