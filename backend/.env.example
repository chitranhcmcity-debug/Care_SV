PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/itc_care
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Leave empty for same-origin requests through the Angular proxy.
CORS_ORIGINS=
# Temporary database and sample data are opt-in and disabled in production.
USE_MEMORY_DB=false
SEED_DEMO=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Trợ lý AI (gợi ý cuộc gọi, đánh giá minh chứng, chat, đánh giá nhân viên).
# Lấy key tại https://platform.openai.com/api-keys. Để trống thì các API /api/ai/* trả lỗi 503 rõ ràng.
OPENAI_API_KEY=
# Tùy chọn, mặc định gpt-4.1-mini nếu để trống.
OPENAI_MODEL=
# Để trống để dùng OpenAI; proxy tương thích phải hỗ trợ POST /v1/responses.
# Chỉ dùng http://localhost:55797/v1 khi backend chạy cùng máy với proxy.
OPENAI_BASE_URL=
# Hoặc dùng Google Gemini: lấy key tại https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Tùy chọn, mặc định gemini-2.5-flash (có thể dùng gemini-2.5-pro).
GEMINI_MODEL=
# openai hoặc gemini. Để trống: dùng OpenAI nếu có OPENAI_API_KEY, không thì Gemini.
AI_PROVIDER=
# Địa chỉ web app dùng để tạo liên kết trong email (xác thực, quên mật khẩu).
# Mặc định http://localhost:4201 (cổng của run_app.bat); khi triển khai thật hãy đặt đúng tên miền.
APP_URL=
# Tùy chọn: chỉ cho tự đăng ký bằng email thuộc các tên miền này (phân tách bằng dấu phẩy),
# VD: itc.edu.vn. Để trống = chấp nhận mọi email.
SIGNUP_EMAIL_DOMAINS=
# Thời hạn liên kết xác thực email khi tự đăng ký (giờ). Mặc định 72 (3 ngày).
VERIFY_EMAIL_HOURS=
# PayOS — thanh toán gói sử dụng hệ thống. Lấy 3 khóa ở my.payos.vn → Kênh thanh toán.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Số ngày dùng thử tính từ lần khởi động đầu tiên (mặc định 30).
SUBSCRIPTION_TRIAL_DAYS=
# Stringee — gọi điện trên trình duyệt + tự động ghi âm (tùy chọn). Để trống thì chỉ dùng
# cách "gọi bằng điện thoại + tải file ghi âm lên". Lấy ở stringee.com → Project → API keys.
# Trong project Stringee, đặt Answer URL = https://<tên-miền>/api/calls/stringee/answer
# và Event URL = https://<tên-miền>/api/calls/stringee/event
STRINGEE_KEY_SID=
STRINGEE_KEY_SECRET=
# Số hotline đã thuê trên Stringee, dùng làm số gọi đi.
STRINGEE_HOTLINE=
# Tài khoản admin đầu tiên: tạo lúc khởi động nếu database CHƯA có admin (kể cả production).
# Mật khẩu 12–128 ký tự. Khi đã có admin thì bị bỏ qua, có thể xóa hai biến này.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Thư mục lưu file ghi âm & minh chứng. Để trống: dùng Railway Volume (RAILWAY_VOLUME_MOUNT_PATH)
# nếu có, không thì backend/uploads.
UPLOAD_DIR=
